# HolyOly API — Environment Variables para Render
#
# DATABASE_URL: Se inyecta automaticamente desde render.yaml
# JWT_SECRET_KEY: Se genera automaticamente en Render
#
# Variables que debes configurar manualmente en el dashboard de Render:

# Google Cloud (Vertex AI / Gemini)
GOOGLE_PROJECT_ID=liftai-evolved-strength
GOOGLE_LOCATION=us-central1
GOOGLE_API_KEY=aiza-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/gcp-key.json

# CORS (origenes permitidos, separados por coma)
CORS_ORIGINS=https://holyoly.vercel.app,http://localhost:5173

# JWT
JWT_SECRET_KEY=tu-secreto-super-seguro-de-64-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=200
RATE_LIMIT_WINDOW_SECONDS=60

# App
DEBUG=false
LOG_LEVEL=INFO
APP_NAME=Holy Oly API
APP_VERSION=1.0.0
