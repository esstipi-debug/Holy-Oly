# Backend environment variables for Render
ENVIRONMENT=production
LOG_LEVEL=info
# CORS_ORIGINS · OPCIONAL (el código ya incluye los dominios canónicos del producto).
# Solo setear esto si querés AGREGAR dominios extra (custom domain, etc).
# CORS_ORIGINS=https://midominio.com,https://otro.com

# Database (auto-injected by render.yaml)
# DATABASE_URL=postgresql://...

# API Keys (add in Render dashboard)
# GOOGLE_API_KEY=
# GOOGLE_PROJECT_ID=

# JWT Secret (generate & set in Render dashboard)
# JWT_SECRET=
